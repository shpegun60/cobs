# Source fingerprints in the hardware evidence are byte-exact. Keep measured
# inputs stable when checking out on Windows with core.autocrlf enabled.
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Raw benchmark records may have a recorded SHA-256 of the complete file, and
# the JSON records carry ELF/source fingerprints. Preserve their original
# bytes instead of normalizing platform newlines.
*.jsonl -text whitespace=trailing-space,space-before-tab,cr-at-eol
*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve the failed programming attempt, including its native whitespace,
# byte-for-byte against the receipt. Do not apply source-format checks to it.
src/wire/tests/hardware/h7s/results_faults_2026-09-12/rtu-crc32-table-115200.log -text -whitespace
